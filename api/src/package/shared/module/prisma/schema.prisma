// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  administrator
  operator
  inspector

  @@map("role")
}

enum InvitationStatus {
  pending
  accepted

  @@map("invitation_status")
}

enum InvitationDeliveryStatus {
  queued
  delivered
  failed

  @@map("invitation_delivery_status")
}

model Organization {
  id         String   @id @default(uuid())
  name       String   @unique @db.Citext
  email      String   @unique @db.Citext
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  memberships Membership[]
  invitations Invitation[]
  activeUsers User[]

  @@map("organizations")
}

model User {
  id                   String  @id @default(uuid())
  name                 String
  email                String  @unique @db.Citext
  password             String
  activeOrganizationId String?

  activeOrganization Organization? @relation(fields: [activeOrganizationId], references: [id])
  memberships        Membership[]
  invitations        Invitation[]

  @@map("users")
}

model Membership {
  id             String @id @default(uuid())
  userId         String
  organizationId String
  role           Role

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Invitation {
  id                    String                   @id @default(uuid())
  userId                String
  organizationId        String
  role                  Role
  secret                String                   @unique
  status                InvitationStatus         @default(pending)
  deliveryStatus        InvitationDeliveryStatus @default(queued)
  deliveryAttempts      Int                      @default(0)
  lastDeliveryFailureAt DateTime?
  createdAt             DateTime                 @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([deliveryStatus])
  @@map("invitations")
}

enum VesselType {
  CARGO
  TANKER
  PASSENGER
  FISHING
  BULK_CARRIER
  CONTAINER
  OTHER

  @@map("vessel_type")
}

model Customer {
  id             String @id @default(uuid())
  organizationId String
  name           String
  email          String @db.Citext
  phone          String

  address CustomerAddress?
  vessels Vessel[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("customers")
}

enum WorkOrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("work_order_status")
}

enum WorkOrderServiceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED

  @@map("work_order_service_status")
}

model WorkOrder {
  id             String          @id @default(uuid())
  organizationId String
  vesselId       String
  startDate      DateTime
  endDate        DateTime
  status         WorkOrderStatus @default(PENDING)

  services              WorkOrderService[]
  inspectionAssignments InspectionAssignment[]

  @@index([organizationId])
  @@index([vesselId])
  @@map("work_orders")
}

model WorkOrderService {
  id             String                 @id @default(uuid())
  organizationId String
  workOrderId    String
  name           String
  description    String
  startDate      DateTime
  endDate        DateTime
  status         WorkOrderServiceStatus @default(PENDING)

  workOrder             WorkOrder               @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  images                WorkOrderServiceImage[]
  inspectionAssignments InspectionAssignment[]

  @@index([organizationId])
  @@map("work_order_services")
}

model WorkOrderServiceImage {
  id             String @id @default(uuid())
  organizationId String
  serviceId      String
  url            String

  service WorkOrderService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("work_order_service_images")
}

model Vessel {
  id             String     @id @default(uuid())
  organizationId String
  customerId     String
  imoNumber      String     @db.Citext
  name           String
  type           VesselType
  length         Float

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([organizationId, imoNumber])
  @@index([organizationId])
  @@map("vessels")
}

model CustomerAddress {
  id             String @id @default(uuid())
  organizationId String
  customerId     String @unique
  address        String
  city           String
  state          String

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([organizationId])
  @@map("customer_addresses")
}

model InspectionTemplate {
  id             String   @id @default(uuid())
  organizationId String
  name           String   @db.Citext
  createdAt      DateTime @default(now())

  items InspectionTemplateItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("inspection_templates")
}

model InspectionTemplateItem {
  id             String       @id @default(uuid())
  organizationId String
  templateId     String
  label          String
  position       Int
  type           QuestionType @default(CONFORMITY)

  template InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, position])
  @@index([organizationId])
  @@map("inspection_template_items")
}

model InspectionAssignment {
  id                 String   @id @default(uuid())
  organizationId     String
  workOrderId        String
  workOrderServiceId String?
  templateName       String
  assignedBy         String
  createdAt          DateTime @default(now())

  workOrder        WorkOrder                  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workOrderService WorkOrderService?          @relation(fields: [workOrderServiceId], references: [id], onDelete: Cascade)
  items            InspectionAssignmentItem[]
  inspections      Inspection[]

  @@index([organizationId])
  @@index([workOrderId])
  @@map("inspection_assignments")
}

model InspectionAssignmentItem {
  id             String       @id @default(uuid())
  organizationId String
  assignmentId   String
  label          String
  position       Int
  type           QuestionType @default(CONFORMITY)

  assignment InspectionAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  answers    InspectionAnswer[]

  @@unique([assignmentId, position])
  @@index([organizationId])
  @@map("inspection_assignment_items")
}

enum QuestionType {
  TEXT
  YES_NO
  CONFORMITY
  SCORE

  @@map("question_type")
}

enum InspectionResult {
  APPROVED
  REPROVED

  @@map("inspection_result")
}

model Inspection {
  id             String           @id @default(uuid())
  organizationId String
  assignmentId   String
  result         InspectionResult
  inspectorId    String
  inspectorName  String
  completedAt    DateTime         @default(now())
  discardedAt    DateTime?
  discardedBy    String?

  // Restrict: an inspected assignment, and so its WorkOrder or target service, is never deleted (D5).
  assignment InspectionAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  answers    InspectionAnswer[]

  @@index([organizationId])
  @@index([assignmentId])
  @@map("inspections")
}

model InspectionAnswer {
  id             String   @id @default(uuid())
  organizationId String
  inspectionId   String
  itemId         String
  notApplicable  Boolean  @default(false)
  textValue      String?
  booleanValue   Boolean?
  scoreValue     Int?
  note           String?

  inspection Inspection               @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  item       InspectionAssignmentItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([inspectionId, itemId])
  @@index([organizationId])
  @@map("inspection_answers")
}

// workforce
// Staff, Team and Assignment; `workOrderId` and `workOrderServiceId` are plain ids of the work-order
// context (no foreign key across contexts, AD-002). An Assignment names exactly one of `staffId` and
// `teamId` (a CHECK in the migration) and a WorkOrderService has at most one (AD-076).

model Team {
  id             String   @id @default(uuid())
  organizationId String
  name           String   @db.Citext
  specialty      String
  createdAt      DateTime @default(now())

  staff       Staff[]
  assignments Assignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("teams")
}

model Staff {
  id             String   @id @default(uuid())
  organizationId String
  name           String   @db.Citext
  specialty      String
  email          String   @db.Citext
  phone          String
  teamId         String?
  createdAt      DateTime @default(now())

  team        Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignments Assignment[]

  @@unique([organizationId, name])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([teamId])
  @@map("staff")
}

model Assignment {
  id                 String   @id @default(uuid())
  organizationId     String
  workOrderId        String
  workOrderServiceId String   @unique
  staffId            String?
  teamId             String?
  createdAt          DateTime @default(now())

  staff Staff? @relation(fields: [staffId], references: [id], onDelete: Restrict)
  team  Team?  @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([workOrderId])
  @@index([staffId])
  @@index([teamId])
  @@map("assignments")
}
