// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  MANAGER
  DEVELOPER
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  role UserRole @default(USER)

  @@map("users")
}

enum VesselType {
  CARGO
  TANKER
  PASSENGER
  FISHING
  BULK_CARRIER
  CONTAINER
  OTHER

  @@map("vessel_type")
}

model Customer {
  id    String @id @default(uuid())
  name  String
  email String @unique
  phone String

  address CustomerAddress?
  vessels Vessel[]

  @@map("customers")
}

enum WorkOrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("work_order_status")
}

enum WorkOrderServiceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED

  @@map("work_order_service_status")
}

model WorkOrder {
  id        String          @id @default(uuid())
  vesselId  String
  startDate DateTime
  endDate   DateTime
  status    WorkOrderStatus @default(PENDING)

  vessel   Vessel             @relation(fields: [vesselId], references: [id])
  services WorkOrderService[]

  @@map("work_orders")
}

model WorkOrderService {
  id          String                 @id @default(uuid())
  workOrderId String
  name        String
  description String
  startDate   DateTime
  endDate     DateTime
  status      WorkOrderServiceStatus @default(PENDING)

  workOrder WorkOrder               @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  images    WorkOrderServiceImage[]

  @@map("work_order_services")
}

model WorkOrderServiceImage {
  id        String @id @default(uuid())
  serviceId String
  url       String

  service WorkOrderService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("work_order_service_images")
}

model Vessel {
  id         String     @id @default(uuid())
  customerId String
  imoNumber  String     @unique
  name       String
  type       VesselType
  length     Float

  customer   Customer    @relation(fields: [customerId], references: [id])
  workOrders WorkOrder[]

  @@map("vessels")
}

model CustomerAddress {
  id         String @id @default(uuid())
  customerId String @unique
  address    String
  city       String
  state      String

  customer Customer @relation(fields: [customerId], references: [id])

  @@map("customer_addresses")
}
